# ============================================================
# PeerBizSync 环境变量配置模板
# 复制为 .env 后修改，敏感信息禁止提交到 Git
# ============================================================

# ---- 数据库模式 ----
# sqlite: 本地SQLite文件数据库（默认，本地测试用）
# mysql:  阿里云RDS MySQL（生产部署用）
DB_TYPE=sqlite

# ---- SQLite 配置（DB_TYPE=sqlite 时生效） ----
SQLITE_PATH=./data.db

# ---- MySQL / 阿里云RDS 配置（DB_TYPE=mysql 时生效） ----
RDS_HOST=your-rds-host.mysql.rds.aliyuncs.com
RDS_PORT=3306
RDS_USER=your_db_user
RDS_PWD=your_db_password
RDS_DB=peer_biz_sync

# ---- JWT 密钥 ----
JWT_SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---- 初始管理员账号 ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!

# ---- 阿里云OSS（预留，Excel文件存储） ----
OSS_ENABLED=false
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=peer-biz-sync-reports
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ---- 跨域白名单（阿里云ECS生产环境） ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend-domain.com

# ---- 日志 & 文件存储路径（适配ECS磁盘） ----
LOG_DIR=./logs
EXCEL_STORAGE_DIR=./reports
